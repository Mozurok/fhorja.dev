{
  "schema_version": 1,
  "cases": [
    {
      "case_id": "recursive-delete",
      "feature": "multimodule",
      "input": {
        "schema_version": 1,
        "layers": [
          {
            "name": "base",
            "values": {
              "db": {
                "host": "local",
                "port": 7
              },
              "keep": true
            }
          },
          {
            "name": "override",
            "values": {
              "db": {
                "host": null,
                "user": "a"
              }
            }
          }
        ]
      },
      "expected": {
        "config": {
          "db": {
            "port": 7,
            "user": "a"
          },
          "keep": true
        },
        "provenance": {
          "/db/port": "base",
          "/db/user": "override",
          "/keep": "base"
        }
      }
    },
    {
